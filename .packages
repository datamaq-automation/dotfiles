# Paquetes instalados manualmente para el setup LXQt
# Formato: paquete  razón

xfce4-terminal          # Terminal preferida (reemplaza qterminal)
xdotool                 # Debugging: simular teclas desde CLI
screengrab              # Screenshots interactivos
lxqt-config-brightness  # Control de brillo
xcape                   # Super key -> Alt+F1 (XRecord, confiable)
gh                      # GitHub CLI (desde repos oficial)
