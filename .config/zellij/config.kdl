// Configuración de Zelij

keybinds clear-defaults=true {
    normal {
        // Navegar panes con Alt+Flechas
        bind "Alt Left" { MoveFocus "Left"; }
        bind "Alt Right" { MoveFocus "Right"; }
        bind "Alt Up" { MoveFocus "Up"; }
        bind "Alt Down" { MoveFocus "Down"; }

        // Navegar windows con Alt+H/L
        bind "Alt h" { GoToPreviousTab; }
        bind "Alt l" { GoToNextTab; }

        // Crear splits con Alt+|/-
        bind "Alt |" { NewPane "Right"; }
        bind "Alt -" { NewPane "Down"; }

        // Redimensionar panes
        bind "Alt +" { Resize "Increase"; }
        bind "Alt _" { Resize "Decrease"; }
    }
}

themes {
    dark {
        fg 224 224 224
        bg 30 30 30
        black 62 68 66
        red 224 107 117
        green 152 195 121
        yellow 184 187 38
        blue 97 175 239
        magenta 198 120 221
        cyan 86 182 194
        white 224 224 224
        orange 184 138 66
    }
}

theme "dark"

ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}

// Modo mouse
mouse {
    mode true
}

// Plugins (comentados por defecto)
