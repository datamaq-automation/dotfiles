// Configuración de Zelij

keybinds clear-defaults=true {
    normal {
        // Navegar panes con Alt+Flechas
        bind "Alt Left" { MoveFocus "Left"; }
        bind "Alt Right" { MoveFocus "Right"; }
        bind "Alt Up" { MoveFocus "Up"; }
        bind "Alt Down" { MoveFocus "Down"; }

        // Navegar windows con Alt+H/L
        bind "Alt h" { GoToPreviousTab; }
        bind "Alt l" { GoToNextTab; }

        // Crear splits
        bind "Alt |" { NewPane "Right"; }
        bind "Alt -" { NewPane "Down"; }

        // Redimensionar panes con Ctrl+Flechas
        bind "Ctrl Left" { Resize "Left" 5; }
        bind "Ctrl Right" { Resize "Right" 5; }
        bind "Ctrl Up" { Resize "Up" 5; }
        bind "Ctrl Down" { Resize "Down" 5; }

        // Prefix: Ctrl+A
        bind "Ctrl a" {
            LaunchOrFocusPlugin "zellij:tab-bar";
        }

        // Reload config
        bind "Ctrl a r" { SwitchToMode "Normal"; }
    }
}

themes {
    dark {
        fg 224 224 224
        bg 30 30 30
        black 62 68 66
        red 224 107 117
        green 152 195 121
        yellow 184 187 38
        blue 97 175 239
        magenta 198 120 221
        cyan 86 182 194
        white 224 224 224
    }
}

theme "dark"

ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}

// Modo mouse
mouse {
    mode true
}

// Plugins
plugins {
    tab-bar { }
    strider { }
    compact-bar { }
}
